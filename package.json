{
  "name": "throughline",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Reconstruct an end-to-end business value stream from multi-source data and render it as an interactive local dashboard.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/core",
    "test": "vitest run",
    "pipeline": "node skills/reconstruct-value-stream/run-pipeline.mjs",
    "demo": "node skills/reconstruct-value-stream/run-pipeline.mjs --vertical saas-implementation --sources examples/synthetic-saas --out out",
    "dashboard": "node packages/dashboard/serve.mjs"
  },
  "dependencies": {
    "@throughline/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
